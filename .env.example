# Copy this file to `.env` and adjust values as needed for local development.
# In production (e.g. Render/Railway), set these as environment variables
# in the hosting platform's dashboard instead of committing a .env file.

APP_NAME="Crypto Dashboard API"
ENVIRONMENT=development

# SQLite by default. For SQLite this is a relative file path.
DATABASE_URL=sqlite:///./crypto_dashboard.db

# JWT settings — generate a real secret for production, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-this-secret-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CoinGecko free public API — no API key required
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_REQUEST_TIMEOUT_SECONDS=15
DEFAULT_COINS_LIMIT=50
